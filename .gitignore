# Private, never committed: how the dashboard is protected, and working notes.
# The ignore exists before the first commit: a secret committed once survives its own deletion.
_ref/

# Pipeline data. The raw harvests and the analysed records are too large for git (~160 MB) and are
# regenerated by `npm run pipeline:all`. The aggregated dashboard files in data/dashboard/ ARE tracked:
# GitHub Pages builds the site from them, and they are the published dataset (CC BY 4.0).
data/raw/
data/analyzed.json
# Copied from data/dashboard/ at build time (web: npm run sync-data), so it can never go stale.
web/public/data/

# Build and dependencies
node_modules/
web/dist/
web/node_modules/

# Local tooling and OS noise
.claude/
.env
*.bundle
.DS_Store
